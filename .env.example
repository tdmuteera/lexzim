NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional server alias (prefer NEXT_PUBLIC_APP_URL so client + server match)
# APP_URL=http://localhost:3000

# Supabase project (Settings → API → Legacy anon / service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server only — never expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional Storage bucket for firm files (default: firm-files)
# SUPABASE_STORAGE_BUCKET=firm-files

# Free tier: direct db.<ref>.supabase.co is often IPv6-only.
# Copy the exact Shared Pooler URI from Supabase Connect (host may be aws-0- OR aws-1-…).
# Transaction mode (app runtime):
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Session mode (drizzle-kit migrate):
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Connection tuning (optional). Raise the timeout on slow/high-latency links:
# pooler handshakes from distant regions can take 3-7 seconds.
# DB_CONNECT_TIMEOUT_SEC=30
# DB_POOL_MAX=10
# How long to stop retrying after a connection failure (milliseconds).
# DB_CIRCUIT_COOLDOWN_MS=8000

# App secrets (generate a long random string for production)
AUTH_SECRET=replace_with_a_long_random_secret

# Phase 2–4 AI — server only (never expose to the browser)
# Managed keys (any combination). Firm BYO keys can also be set in Settings → AI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: encryption secret for firm BYO keys (falls back to AUTH_SECRET)
# AI_VAULT_SECRET=

# Optional LexZim AI proxy (P4-06). Master keys stay on proxy/app server only.
# AI_PROXY_URL=https://your-ai-proxy.up.railway.app
# AI_PROXY_TOKEN_PEPPER=
# AI_PROXY_PORT=8787

# Phase 5 client portal (same Next.js app at /portal)
# Dev default: enabled when unset. Production: set explicitly.
# PORTAL_ENABLED=1
# PORTAL_ENABLED=0
# Optional dedicated signing secret (falls back to AUTH_SECRET)
# PORTAL_SESSION_SECRET=
# Return magic-link URLs in API JSON (default on in non-production)
# PORTAL_RETURN_MAGIC_LINK=1

# Phase 7 outbound email (P7-11). Firm BYO SMTP in Settings → Email wins.
# Shared relay fallback when a firm has no SMTP configured:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Firm Name <billing@firm.example>"
# SMTP_REPLY_TO=
# CI / smoke without a real SMTP server (nodemailer jsonTransport):
# EMAIL_MOCK=1
